# Copy this file to .env before running the Next.js app locally.
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Server-side Firebase Admin access for verified sessions and Firestore-backed knowledge storage.
# In Firebase App Hosting this comes from the runtime automatically.
# For local development, either set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file
# or provide the fields below.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
